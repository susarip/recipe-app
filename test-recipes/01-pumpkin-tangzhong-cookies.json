      "steps": [
        { "id": "s1", "text": "Make the tangzhong: cook the pumpkin puree and 70 g flour over medium heat, stirring constantly, 5 to 6 minutes until it forms a thick paste. Set aside off the heat. You will use 200 g of it; the rest keeps in the fridge up to two weeks.", "uses": ["i1", "i2"], "timerMinutes": 5, "makeAhead": { "maxDaysAhead": 14, "store": "fridge", "note": "covered; the recipe uses about half the batch" } },
