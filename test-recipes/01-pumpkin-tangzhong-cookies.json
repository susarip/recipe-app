        { "id": "s3", "text": "Set the bowl of brown butter over an ice bath and whisk until it reaches a softened-butter texture, 3 to 4 minutes.", "uses": ["i3"], "timerMinutes": 3 },
        { "id": "s4", "text": "Beat the cooled butter with both sugars 9 to 10 minutes until fluffy. Add the eggs and vanilla and beat 2 to 3 minutes more.", "uses": ["i3", "i8", "i9", "i10", "i11"], "timerMinutes": 9 },
        { "id": "s5", "text": "Whisk the flours, baking powder, baking soda and salt together.", "uses": ["i12", "i13", "i14", "i15", "i16"] },
        { "id": "s6", "text": "Add the dry ingredients to the mixer, then 200 g of the tangzhong, and mix on low until just combined. Scrape the bowl well.", "uses": ["i12", "i13", "i14", "i15", "i16", "i1", "i2"] },
        { "id": "s7", "text": "Fold in most of the chocolate, keeping about 2 oz for topping. Cover the very soft dough and chill overnight, up to 48 hours.", "uses": ["i17"], "leadTimeHours": 12, "makeAhead": { "maxDaysAhead": 2, "store": "fridge", "note": "or freeze portioned dough up to 3 months and bake from frozen with 2 to 3 extra minutes" } },
        { "id": "s8", "text": "Heat the oven to 350F convection or 375F standard.", "uses": [] },
