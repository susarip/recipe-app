# Where the SQLite file lives (default: ./data/recipes.db)
DATABASE_FILE=
# Folder with canonical-ingredients.csv (default: ../data)
DATA_DIR=
# Public URL of the app, needed for form posts (CSRF check), e.g. https://recipes.example.com
ORIGIN=http://localhost:3000
# Shared password for the app; leave empty to run without a login (local use)
APP_PASSWORD=
